# Conexão direta com o PostgreSQL do Supabase (usado pelo Prisma)
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[REFERENCIA_DO_SUPABASE].supabase.co:5432/postgres?schema=public"

# Configurações do Supabase no Front-end (Realtime/Auth)
VITE_SUPABASE_URL="https://[REFERENCIA_DO_SUPABASE].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUA_CHAVE_ANON_DO_SUPABASE]"
